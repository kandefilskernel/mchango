# Copier en .env pour le développement local (docker compose up -d à la racine).
# Valeurs de DÉVELOPPEMENT uniquement : en production, chaque secret vient d'un gestionnaire de secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://mchango_api:mchango_api_dev@127.0.0.1:5432/mchango
REDIS_URL=redis://127.0.0.1:6379
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-0000
OTP_PEPPER=dev-only-change-me-dev-only-change-me-1111
SMS_DRIVER=console
OTP_MAX_PER_IP_PER_HOUR=200
TRUST_PROXY=0
# Client web de développement (flutter run -d chrome --web-port 8080)
CORS_ORIGINS=http://localhost:8080
# Rappels SMS avant échéance
REMINDERS_ENABLED=1
REMINDERS_INTERVAL_MINUTES=15
# Back-office : secret des jetons de l'équipe et clé de chiffrement des secrets 2FA (32 octets base64)
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STAFF_JWT_SECRET=dev-only-staff-secret-change-me-0000000000
STAFF_SECRET_KEY=Yk7seuECLA/5VvnrmqvrJrq8HC2UemA2CWV28sLsO9g=
# DÉVELOPPEMENT SEULEMENT : accepte le code 2FA 000000 au back-office. L'API refuse de démarrer en production avec 1.
STAFF_2FA_DEV_BYPASS=0
# Durée d'une session du back-office, en heures (8 par défaut, 24 au plus, 12 au plus en production)
STAFF_SESSION_HOURS=8
# Agent IA du back-office (Claude). Vide = désactivé : seules les règles automatiques tournent.
# Données envoyées pseudonymisées (M1, M2…, sans noms ni numéros). Voir spec/backoffice.md.
ANTHROPIC_API_KEY=
# Plafond d'analyses IA par jour, toute l'équipe confondue (chaque analyse est facturée)
AI_REVIEWS_PER_DAY=30
